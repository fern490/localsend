{
  "expo": {
    "name": "LocalSend Clase",
    "slug": "localsend-clase",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.clase.localsend",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "LocalSend usa la red local para encontrar tu computadora y enviarle archivos directamente.",
        "NSBonjourServices": ["_localsend-clase._udp", "_localsend-clase._tcp"],
        "NSPhotoLibraryUsageDescription": "Para elegir fotos y videos que quieras enviar."
      }
    },
    "android": {
      "package": "com.clase.localsend",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para elegir fotos y videos que quieras enviar."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Para guardar en la galería las fotos y videos que recibas.",
          "savePhotosPermission": "Para guardar en la galería las fotos y videos que recibas."
        }
      ]
    ]
  }
}
